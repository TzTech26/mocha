# ngrok authtoken, from https://dashboard.ngrok.com/get-started/your-authtoken.
# Leave blank to use the token saved by `ngrok config add-authtoken`.
NGROK_AUTHTOKEN=

# Up to three simultaneous tunnels. A tunnel is started for every NGROK_PORT_N
# that is set; the matching NGROK_DOMAIN_N is the reserved ngrok domain to
# forward from. Leave a domain blank to get a random ngrok url instead. A port
# may also be written as host:port to reach a service on another machine.
NGROK_DOMAIN_1=mocha.ngrok.app
NGROK_PORT_1=3003

NGROK_DOMAIN_2=
NGROK_PORT_2=

NGROK_DOMAIN_3=
NGROK_PORT_3=
